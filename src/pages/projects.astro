---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPost from '../components/ProjectPost.astro';
const allPosts = await Astro.glob('../pages/posts/*.md');
const pageTitle = "Blog"
const pageHeader = "My Blog"
---
<BaseLayout pageTitle={pageTitle}, pageHeader={pageHeader}>
  <p>This is my blog.</p>
  <ul>
    {allPosts.map((post) => <ProjectPost url={post.url} title={post.frontmatter.title} />)}
  </ul>
</BaseLayout>
