---
import BaseLayout from './BaseLayout.astro';
import '../styles/tag.css';
const { frontmatter } = Astro.props;
---
<BaseLayout pageTitle={` - ${frontmatter.title}`}>
  <div class="contents">
    <div class="tags">
      {frontmatter.tags.map((tag) => (
      <p class="tag"><a href={`/tags/${tag}`}>#{tag}</a></p>
      ))}
    </div>
    <slot />
  </div>
</BaseLayout>

